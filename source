<body>
  <section id="loginView" class="login-screen">
    <div class="login-art">
      <div class="login-brand"><div class="crest">⌂</div><div><strong>Budhanilkantha School</strong><span>Academic Attendance Portal</span></div></div>
      <div class="login-message"><span class="kicker">Faculty workspace</span><h1>Every school day, clearly accounted for.</h1><p>Manage the senior school roll, take attendance by date, and preserve each academic year in one simple offline application.</p></div>
      <div class="login-foot">Budhanilkantha School · Faculty use</div>
    </div>
    <div class="login-panel">
      <form id="loginForm" class="login-card">
        <div class="mobile-brand login-brand"><div class="crest">⌂</div><div><strong>Budhanilkantha School</strong><span>Attendance Portal</span></div></div>
        <span class="eyebrow">Faculty access</span><h2>Welcome back.</h2><p>Sign in to open the student and attendance records stored on this device.</p>
        <label class="field"><span>Faculty name</span><input id="loginName" required maxlength="60" placeholder="Enter your name" autocomplete="name"></label>
        <label class="field"><span>Access code</span><input id="loginCode" required type="password" placeholder="Enter access code" autocomplete="current-password"></label>
        <div id="loginError" class="form-error hidden">Incorrect access code.</div>
        <button class="login-button" type="submit">Open faculty portal</button>
        <div class="access-note"><span>🔒</span><div><b>Offline demonstration access</b><br>Use code <b>BNKS2026</b>. Data remains in this browser.</div></div>
      </form>
    </div>
  </section>

  <div id="appView" class="app hidden">
    <aside id="sidebar" class="sidebar">
      <button id="closeNav" class="close-nav" aria-label="Close navigation">×</button>
      <div class="brand"><div class="crest">⌂</div><div><strong>Budhanilkantha</strong><span>Academic Portal</span></div></div>
      <nav class="nav" aria-label="Main navigation">
        <button data-page="overview" class="active"><span class="nav-icon">▦</span><span>Overview</span></button>
        <button data-page="attendance"><span class="nav-icon">✓</span><span>Attendance</span><b id="unmarkedBadge" class="nav-badge hidden">0</b></button>
        <button data-page="students"><span class="nav-icon">♙</span><span>Students</span></button>
        <button data-page="years"><span class="nav-icon">□</span><span>Academic years</span></button>
      </nav>
      <div class="side-spacer"></div>
      <div class="storage-note"><span>◈</span><div><b>Stored on this device</b><small>Export CSV backups regularly</small></div></div>
      <div class="profile"><div id="profileAvatar" class="avatar">FT</div><div><b id="profileName">Faculty user</b><small>Full access</small></div><button id="logoutButton" title="Sign out" aria-label="Sign out">↪</button></div>
    </aside>
    <button id="scrim" class="scrim hidden" aria-label="Close navigation"></button>
    <main class="main">
      <header class="topbar">
        <button id="menuButton" class="menu-button" aria-label="Open navigation">☰</button>
        <div class="crumb"><span>Faculty portal</span><span>/</span><b id="crumbTitle">Overview</b></div>
        <div class="top-actions">
          <label class="date-box" title="Choose attendance date"><span>▣</span><input id="globalDate" type="date" aria-label="Choose date"></label>
          <label class="select-box"><span>⌄</span><select id="yearSelect" aria-label="Academic year"></select></label>
          <div id="topAvatar" class="avatar small">FT</div>
        </div>
      </header>
      <div id="content" class="content"></div>
    </main>
  </div>

  <div id="modalRoot"></div><div id="toastRoot"></div><input id="csvInput" class="sr-only" type="file" accept=".csv,text/csv">

  <script>
  (() => {
    'use strict';
    const STORAGE_KEY='bnks_attendance_single_v1', SESSION_KEY='bnks_faculty_session';
    const CLASSES=['A1','A2','Grade 11','Grade 12'];
    const CAMBRIDGE=['PCF','PCB','PCC','EBA','EBC'];
    const NEB=['PCB (NEB)','PCC (NEB)'];
    const STATUSES=['Present','Absent','Late','Leave'];
    const today=()=>new Date().toISOString().slice(0,10);
    const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,8);
    const esc=(v)=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const combosFor=(level)=>level==='A1'||level==='A2'?CAMBRIDGE:NEB;
    const stageFor=(level)=>level==='A1'||level==='Grade 11'?'1st academic year':'2nd academic year';
    const initials=(name)=>String(name).split(/\s+/).filter(Boolean).slice(0,2).map(p=>p[0]).join('').toUpperCase()||'FT';
    const statusClass=(status)=>'status-'+String(status||'Unmarked').toLowerCase();
    const formatDate=(date,full=false)=>new Intl.DateTimeFormat('en-GB',full?{weekday:'long',day:'numeric',month:'long',year:'numeric'}:{day:'numeric',month:'short',year:'numeric'}).format(new Date(date+'T12:00:00'));

    const seed=()=>{
      const y1='year-current',y0='year-archive';
      const students=[
        ['1101','Aarav Shrestha','A1','PCF'],['1102','Nima Sherpa','A1','PCB'],['1103','Prakriti Karki','A1','PCC'],['1104','Sanjay Gurung','A1','EBA'],['1105','Aayusha Thapa','A1','EBC'],
        ['1201','Rohan Basnet','A2','PCF'],['1202','Sneha Joshi','A2','PCB'],['1203','Tenzin Lama','A2','PCC'],['1204','Ishika Adhikari','A2','EBA'],['1205','Bibek Pandey','A2','EBC'],
        ['2101','Samriddhi Rana','Grade 11','PCB (NEB)'],['2102','Kushal Bhandari','Grade 11','PCC (NEB)'],['2201','Anisha Tamang','Grade 12','PCB (NEB)'],['2202','Suyog Poudel','Grade 12','PCC (NEB)']
      ].map((s,i)=>({id:'s'+(i+1),roll:s[0],name:s[1],level:s[2],combo:s[3],yearId:y1,active:true}));
      students.push({id:'s-old',roll:'1051',name:'Alumni Sample',level:'A2',combo:'PCC',yearId:y0,active:false});
      const day={}; const seeded=['Present','Present','Absent','Late','Present','Present','Leave','Present','Present','Present','Present','Late','Present','Absent'];
      students.filter(s=>s.yearId===y1).forEach((s,i)=>day[s.id]=seeded[i]);
      return {years:[{id:y1,label:'2026–2027',current:true,archived:false},{id:y0,label:'2025–2026',current:false,archived:true}],students,attendance:{[today()]:day},selectedYearId:y1,selectedDate:today()};
    };
    let state; try{state=JSON.parse(localStorage.getItem(STORAGE_KEY))||seed()}catch{state=seed()}
    let page='overview',faculty=sessionStorage.getItem(SESSION_KEY)||'',filters={search:'',level:'All classes',combo:'All combinations',activity:'All students'};
    const $=(q,root=document)=>root.querySelector(q), $$=(q,root=document)=>[...root.querySelectorAll(q)];
    const save=()=>localStorage.setItem(STORAGE_KEY,JSON.stringify(state));
    const selectedYear=()=>state.years.find(y=>y.id===state.selectedYearId)||state.years[0];
    const yearStudents=(includeInactive=true)=>state.students.filter(s=>s.yearId===state.selectedYearId&&(includeInactive||s.active));
    const dayRecords=()=>state.attendance[state.selectedDate]||{};
    const yearAttendance=(studentId)=>Object.entries(state.attendance).flatMap(([date,records])=>records[studentId]?[{date,status:records[studentId]}]:[]).sort((a,b)=>b.date.localeCompare(a.date));
    const rateFor=(studentId)=>{const rows=yearAttendance(studentId);return rows.length?Math.round(rows.filter(r=>r.status==='Present'||r.status==='Late').length/rows.length*1000)/10:0};
    const calcStats=()=>{const active=yearStudents(false),r=dayRecords(),out={total:active.length,present:0,absent:0,late:0,leave:0,unmarked:0,rate:0};active.forEach(s=>{const v=r[s.id];if(v)out[v.toLowerCase()]++;else out.unmarked++});const marked=out.total-out.unmarked;out.rate=marked?Math.round((out.present+out.late)/marked*1000)/10:0;return out};
    const toast=(message,type='success')=>{$('#toastRoot').innerHTML=`<div class="toast ${type}"><span>${type==='success'?'✓':'!'}</span><span>${esc(message)}</span><button aria-label="Dismiss">×</button></div>`;$('.toast button').onclick=()=>$('#toastRoot').innerHTML='';setTimeout(()=>{if($('.toast'))$('#toastRoot').innerHTML=''},3400)};

    function showApp(){
      const logged=Boolean(faculty);$('#loginView').classList.toggle('hidden',logged);$('#appView').classList.toggle('hidden',!logged);
      if(logged){$('#profileName').textContent=faculty;$('#profileAvatar').textContent=$('#topAvatar').textContent=initials(faculty);$('#globalDate').value=state.selectedDate;renderYearSelect();render()}
    }
    function renderYearSelect(){const sel=$('#yearSelect');sel.innerHTML=state.years.map(y=>`<option value="${y.id}" ${y.id===state.selectedYearId?'selected':''}>${esc(y.label)}${y.archived?' · Archived':''}</option>`).join('')}
    function render(){
      $('#crumbTitle').textContent={overview:'Overview',attendance:'Attendance',students:'Students',years:'Academic years'}[page];$$('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
      const stats=calcStats();$('#unmarkedBadge').textContent=stats.unmarked;$('#unmarkedBadge').classList.toggle('hidden',!stats.unmarked);
      if(page==='overview')renderOverview();else if(page==='attendance')renderAttendance();else if(page==='students')renderStudents();else renderYears();
    }
    const heading=(eyebrow,title,subtitle,actions='')=>`<section class="page-head"><div><span class="eyebrow">${eyebrow}</span><h1>${title}</h1><p>${subtitle}</p></div>${actions?`<div class="page-actions">${actions}</div>`:''}</section>`;
    function metric(icon,tone,label,value,helper){return `<article class="panel metric"><div class="metric-icon ${tone}">${icon}</div><div><span>${label}</span><b>${value}</b><small>${helper}</small></div></article>`}
    function renderOverview(){
      const y=selectedYear(),s=calcStats(),records=dayRecords();
      const classes=CLASSES.map(level=>{const list=yearStudents(false).filter(x=>x.level===level),marked=list.filter(x=>records[x.id]).length,pct=list.length?Math.round(marked/list.length*100):0;return `<div class="class-row"><div class="class-chip">${level.replace('Grade ','G')}</div><div class="class-info"><div><b>${level}</b><span>${marked} of ${list.length} marked</span></div><div class="bar"><i style="width:${pct}%"></i></div></div><strong>${pct}%</strong></div>`}).join('');
      const list=yearStudents(false).slice(0,7).map(st=>{const status=records[st.id]||'Unmarked',rate=rateFor(st.id);return `<tr><td><div class="student-cell"><span class="avatar small">${initials(st.name)}</span><b>${esc(st.name)}</b></div></td><td><code>${st.roll}</code></td><td>${st.level}</td><td><span class="pill combo">${st.combo}</span></td><td><span class="pill ${statusClass(status)}">${status}</span></td><td><div class="progress-cell"><span>${rate}%</span><i class="mini-bar"><i style="width:${rate}%"></i></i></div></td></tr>`}).join('');
      $('#content').innerHTML=heading(`${formatDate(state.selectedDate,true)} · ${esc(y.label)}`,'Good morning, faculty.','Here is the attendance picture for the selected date.',`<button class="primary" data-go="attendance">✓ Take attendance</button>`)+
        `<section class="metrics">${metric('♙','green','Active students',s.total,'Across all four classes')}${metric('✓','blue','Present',s.present,s.rate+'% attendance rate')}${metric('×','red','Absent',s.absent,s.absent?'Requires follow-up':'No absences recorded')}${metric('◷','amber','Late / Leave',s.late+s.leave,s.unmarked+' still unmarked')}</section>`+
        `<section class="dashboard-grid"><article class="panel"><div class="panel-head"><div><h2>Attendance overview</h2><p>Status distribution for ${formatDate(state.selectedDate)}</p></div><button class="ghost" data-go="attendance">View register</button></div><div class="overview-body"><div class="donut" style="--rate:${s.rate*3.6}deg"><div><b>${s.rate}%</b><span>Attendance</span></div></div><div class="legend">${['Present','Absent','Late','Leave'].map(v=>`<div class="legend-row"><i class="dot ${statusClass(v)}"></i><span>${v}</span><b>${s[v.toLowerCase()]}</b></div>`).join('')}</div></div></article><article class="panel"><div class="panel-head"><div><h2>Class coverage</h2><p>Marked students by academic level</p></div></div><div class="class-list">${classes}</div></article></section>`+
        `<article class="panel snapshot"><div class="panel-head"><div><h2>Student snapshot</h2><p>Daily status and cumulative attendance</p></div><button class="secondary" data-export="attendance">⇩ Export attendance</button></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Roll no.</th><th>Class</th><th>Combination</th><th>Selected date</th><th>Overall</th></tr></thead><tbody>${list||emptyRow(6,'No active students','Add students to this academic year.')}</tbody></table></div></article>`;
      bindCommon();
    }
    function renderAttendance(){
      const y=selectedYear(),readOnly=y.archived,students=filteredStudents(true),records=dayRecords();
      const rows=students.map(st=>`<tr><td><div class="student-cell"><span class="avatar small">${initials(st.name)}</span><div><b>${esc(st.name)}</b><small>${st.active?'Active student':'Inactive'}</small></div></div></td><td><code>${st.roll}</code></td><td><b>${st.level}</b><small style="display:block;margin-top:3px;color:#89958f">${st.combo}</small></td><td><div class="status-picker">${STATUSES.map(v=>`<button class="${statusClass(v)} ${records[st.id]===v?'selected':''}" data-status="${v}" data-student="${st.id}" ${readOnly?'disabled':''}>${v}</button>`).join('')}<button class="${statusClass('Unmarked')} ${!records[st.id]?'selected':''}" data-status="" data-student="${st.id}" ${readOnly?'disabled':''}>Clear</button></div></td></tr>`).join('');
      const actions=readOnly?`<span class="read-only">▣ Archived · Read only</span>`:`<button class="secondary" id="markAllPresent">✓ Mark visible present</button>`;
      $('#content').innerHTML=heading(`Daily register · ${esc(y.label)}`,'Attendance',readOnly?'Archived records can be viewed and exported, but not changed.':'Choose any date, then mark or correct each student’s attendance.',actions)+filtersHtml(true)+`<article class="panel attendance-panel"><div class="attendance-head"><div><b>${students.length} students</b><span>${formatDate(state.selectedDate,true)} · Changes save immediately</span></div><div class="status-key">${STATUSES.map(v=>`<span><i class="dot ${statusClass(v)}"></i>${v}</span>`).join('')}</div></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Roll no.</th><th>Class & combination</th><th>Attendance status</th></tr></thead><tbody>${rows||emptyRow(4,'No students found','Clear a filter or add students to this year.')}</tbody></table></div></article>`;
      bindFilters();bindCommon();$$('[data-status]').forEach(b=>b.onclick=()=>{const map=state.attendance[state.selectedDate]||(state.attendance[state.selectedDate]={});if(b.dataset.status)map[b.dataset.student]=b.dataset.status;else delete map[b.dataset.student];save();render();toast('Attendance saved for '+formatDate(state.selectedDate))});if($('#markAllPresent'))$('#markAllPresent').onclick=()=>{filteredStudents(true).forEach(st=>(state.attendance[state.selectedDate]||(state.attendance[state.selectedDate]={}))[st.id]='Present');save();render();toast('Visible students marked present')};
    }
    function filtersHtml(attendance=false){const combos=[...new Set(yearStudents(true).filter(s=>filters.level==='All classes'||s.level===filters.level).map(s=>s.combo))];return `<section class="panel toolbar">${attendance?`<label class="date-control"><span>▣</span><input id="pageDate" type="date" value="${state.selectedDate}" aria-label="Attendance date"></label>`:`<label class="search"><span>⌕</span><input id="searchInput" value="${esc(filters.search)}" placeholder="Search name or 4-digit roll number"></label>`}<label class="filter"><select id="levelFilter"><option>All classes</option>${CLASSES.map(v=>`<option ${filters.level===v?'selected':''}>${v}</option>`).join('')}</select></label><label class="filter"><select id="comboFilter"><option>All combinations</option>${combos.map(v=>`<option ${filters.combo===v?'selected':''}>${v}</option>`).join('')}</select></label>${attendance?`<label class="search"><span>⌕</span><input id="searchInput" value="${esc(filters.search)}" placeholder="Search student"></label>`:`<label class="filter"><select id="activityFilter"><option>All students</option><option ${filters.activity==='Active'?'selected':''}>Active</option><option ${filters.activity==='Inactive'?'selected':''}>Inactive</option></select></label>`}</section>`}
    function filteredStudents(activeOnly=false){const q=filters.search.trim().toLowerCase();return yearStudents(!activeOnly).filter(s=>(!activeOnly||s.active)&&(filters.level==='All classes'||s.level===filters.level)&&(filters.combo==='All combinations'||s.combo===filters.combo)&&(filters.activity==='All students'||(filters.activity==='Active'?s.active:!s.active))&&(!q||s.name.toLowerCase().includes(q)||s.roll.includes(q)))}
    function bindFilters(){const rerender=()=>render();$('#searchInput').oninput=e=>{filters.search=e.target.value;rerender()};$('#levelFilter').onchange=e=>{filters.level=e.target.value;filters.combo='All combinations';rerender()};$('#comboFilter').onchange=e=>{filters.combo=e.target.value;rerender()};if($('#activityFilter'))$('#activityFilter').onchange=e=>{filters.activity=e.target.value;rerender()};if($('#pageDate'))$('#pageDate').onchange=e=>changeDate(e.target.value)}
    function renderStudents(){
      const y=selectedYear(),readOnly=y.archived,students=filteredStudents(false);const rows=students.map(st=>`<tr><td><button class="ghost student-cell" data-history="${st.id}"><span class="avatar small">${initials(st.name)}</span><b>${esc(st.name)}</b></button></td><td><code>${st.roll}</code></td><td><b>${st.level}</b></td><td>${stageFor(st.level)}</td><td><span class="pill combo">${st.combo}</span></td><td><span class="pill ${st.active?'active-pill':'inactive-pill'}">${st.active?'Active':'Inactive'}</span></td><td><div class="row-actions"><button class="icon-button" data-history="${st.id}" title="Attendance history">◷</button>${readOnly?'':`<button class="icon-button" data-edit="${st.id}" title="Edit">✎</button><button class="icon-button red" data-delete="${st.id}" title="Delete">⌫</button>`}</div></td></tr>`).join('');
      const actions=readOnly?`<span class="read-only">▣ Archived · Read only</span>`:`<button class="secondary" id="importButton">⇧ Import CSV</button><button class="primary" id="addStudent">＋ Add student</button>`;
      $('#content').innerHTML=heading(`Student directory · ${esc(y.label)}`,'Students',readOnly?'Archived student records remain searchable and exportable.':'Add, edit, search, import, and export this academic year’s student roll.',actions)+filtersHtml(false)+`<article class="panel snapshot"><div class="attendance-head"><div><b>${students.length} student${students.length===1?'':'s'}</b><span>${yearStudents(false).length} active in ${esc(y.label)}</span></div><div class="page-actions"><button class="secondary" data-template>▤ CSV template</button><button class="secondary" data-export="students">⇩ Export students</button></div></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Roll no.</th><th>Class</th><th>Academic stage</th><th>Combination</th><th>Status</th><th>Actions</th></tr></thead><tbody>${rows||emptyRow(7,'No students found','Adjust the filters or add a new student.')}</tbody></table></div></article>`;
      bindFilters();bindCommon();if($('#addStudent'))$('#addStudent').onclick=()=>openStudentModal();if($('#importButton'))$('#importButton').onclick=()=>$('#csvInput').click();$$('[data-edit]').forEach(b=>b.onclick=()=>openStudentModal(state.students.find(s=>s.id===b.dataset.edit)));$$('[data-delete]').forEach(b=>b.onclick=()=>confirmDelete(b.dataset.delete));$$('[data-history]').forEach(b=>b.onclick=()=>openHistory(b.dataset.history));
    }
    function renderYears(){
      const cards=state.years.map(y=>{const count=state.students.filter(s=>s.yearId===y.id).length;return `<article class="panel year-card ${y.current?'current':''}"><div class="year-top"><div class="year-icon">▣</div><div><span class="year-tag ${y.current?'current':y.archived?'archived':'open'}">${y.current?'Current year':y.archived?'Archived':'Open'}</span><h2>${esc(y.label)}</h2></div></div><div class="year-stats"><div><b>${count}</b><span>Students</span></div><div><b>${y.archived?'Read only':'Editable'}</b><span>Record state</span></div></div><div class="card-actions"><button data-open-year="${y.id}">Open records</button><button data-export-year="${y.id}">⇩ Attendance</button>${y.archived?`<button data-year-action="restore" data-year="${y.id}">↶ Restore</button>`:!y.current?`<button data-year-action="current" data-year="${y.id}">✓ Set current</button><button class="red" data-year-action="archive" data-year="${y.id}">□ Archive</button>`:''}</div></article>`}).join('');
      $('#content').innerHTML=heading('Annual rollover','Academic years','Start a clean student roll while preserving old attendance and student history.',`<button class="primary" id="newYear">＋ New academic year</button>`)+`<section class="year-guide"><div class="year-step"><strong>1</strong><span><b>Create the new year</b><small>Start with a clean student roll.</small></span></div><i class="guide-line"></i><div class="year-step"><strong>2</strong><span><b>Import students</b><small>Use CSV or add them manually.</small></span></div><i class="guide-line"></i><div class="year-step"><strong>3</strong><span><b>Archive the old year</b><small>History stays available.</small></span></div></section><section class="year-grid">${cards}</section>`;
      $('#newYear').onclick=openYearModal;$$('[data-open-year]').forEach(b=>b.onclick=()=>{state.selectedYearId=b.dataset.openYear;save();renderYearSelect();page='students';render()});$$('[data-export-year]').forEach(b=>b.onclick=()=>exportAttendance(b.dataset.exportYear));$$('[data-year-action]').forEach(b=>b.onclick=()=>yearAction(b.dataset.year,b.dataset.yearAction));bindCommon();
    }
    function bindCommon(){$$('[data-go]').forEach(b=>b.onclick=()=>{page=b.dataset.go;render()});$$('[data-export="students"]').forEach(b=>b.onclick=exportStudents);$$('[data-export="attendance"]').forEach(b=>b.onclick=()=>exportAttendance(state.selectedYearId));$$('[data-template]').forEach(b=>b.onclick=exportTemplate)}
    function emptyRow(cols,title,text){return `<tr><td colspan="${cols}"><div class="table-empty"><b>${title}</b><span>${text}</span></div></td></tr>`}

    function openStudentModal(student=null){
      const y=selectedYear();if(y.archived)return toast('Restore this academic year before editing.','error');const level=student?.level||'A1',valid=combosFor(level);
      $('#modalRoot').innerHTML=`<div class="modal-backdrop"><form id="studentForm" class="modal"><div class="modal-head"><div><span class="eyebrow">Student record</span><h2>${student?'Edit student':'Add student'}</h2></div><button type="button" data-close>×</button></div><div class="modal-body"><div id="studentError" class="form-error hidden"></div><div class="form-grid"><label class="field"><span>4-digit roll number</span><input id="studentRoll" required inputmode="numeric" pattern="[0-9]{4}" maxlength="4" value="${esc(student?.roll||'')}" placeholder="1101"></label><label class="field"><span>Full name</span><input id="studentName" required maxlength="100" value="${esc(student?.name||'')}" placeholder="Student full name"></label><label class="field"><span>Class</span><select id="studentLevel">${CLASSES.map(v=>`<option ${level===v?'selected':''}>${v}</option>`).join('')}</select><small id="stageHelp">${stageFor(level)}</small></label><label class="field"><span>Subject combination</span><select id="studentCombo">${valid.map(v=>`<option ${student?.combo===v?'selected':''}>${v}</option>`).join('')}</select><small>Restricted automatically by class.</small></label><label class="check-field"><input id="studentActive" type="checkbox" ${student?.active===false?'':'checked'}><span><b>Active student</b><small>Inactive students remain in historical records.</small></span></label></div></div><div class="modal-actions"><button class="secondary" type="button" data-close>Cancel</button><button class="primary" type="submit">${student?'Save changes':'Add student'}</button></div></form></div>`;
      $$('[data-close]',$('#modalRoot')).forEach(b=>b.onclick=closeModal);$('#studentRoll').oninput=e=>e.target.value=e.target.value.replace(/\D/g,'').slice(0,4);$('#studentLevel').onchange=e=>{const opts=combosFor(e.target.value);$('#studentCombo').innerHTML=opts.map(v=>`<option>${v}</option>`).join('');$('#stageHelp').textContent=stageFor(e.target.value)};$('#studentForm').onsubmit=e=>{e.preventDefault();const roll=$('#studentRoll').value,name=$('#studentName').value.trim(),lvl=$('#studentLevel').value,combo=$('#studentCombo').value,duplicate=state.students.find(s=>s.yearId===state.selectedYearId&&s.roll===roll&&s.id!==student?.id);if(!/^\d{4}$/.test(roll)||name.length<2||duplicate){const box=$('#studentError');box.textContent=duplicate?'That roll number already exists in this academic year.':'Enter a valid 4-digit roll number and full name.';box.classList.remove('hidden');return}if(student)Object.assign(student,{roll,name,level:lvl,combo,active:$('#studentActive').checked});else state.students.push({id:uid(),roll,name,level:lvl,combo,yearId:state.selectedYearId,active:$('#studentActive').checked});save();closeModal();render();toast(student?'Student updated.':'Student added.')}
    }
    function confirmDelete(id){const s=state.students.find(x=>x.id===id);$('#modalRoot').innerHTML=`<div class="modal-backdrop"><div class="modal small confirm"><div class="confirm-icon">⌫</div><h2>Delete ${esc(s.name)}?</h2><p>This permanently removes the student and every attendance record connected to them. Mark the student inactive if you need to preserve history.</p><div class="modal-actions" style="justify-content:center"><button class="secondary" data-close>Cancel</button><button class="danger" id="confirmDelete">Delete permanently</button></div></div></div>`;$('[data-close]').onclick=closeModal;$('#confirmDelete').onclick=()=>{state.students=state.students.filter(x=>x.id!==id);Object.values(state.attendance).forEach(r=>delete r[id]);save();closeModal();render();toast('Student deleted.')}}
    function openHistory(id){const st=state.students.find(s=>s.id===id),rows=yearAttendance(id),rate=rateFor(id),absent=rows.filter(r=>r.status==='Absent').length;$('#modalRoot').innerHTML=`<div class="modal-backdrop"><div class="modal"><div class="modal-head"><div><span class="eyebrow">Attendance history</span><h2>${esc(st.name)}</h2><p>Roll ${st.roll} · ${st.level} · ${st.combo}</p></div><button data-close>×</button></div><div class="history-summary"><div><b>${rate}%</b><span>Attendance</span></div><div><b>${rows.length}</b><span>Marked days</span></div><div><b>${absent}</b><span>Absences</span></div></div><div class="history-table table-wrap"><table><thead><tr><th>Date</th><th>Status</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${formatDate(r.date)}</td><td><span class="pill ${statusClass(r.status)}">${r.status}</span></td></tr>`).join('')||emptyRow(2,'No attendance history','This student has not been marked yet.')}</tbody></table></div><div class="modal-actions"><button class="primary" data-close>Done</button></div></div></div>`;$$('[data-close]',$('#modalRoot')).forEach(b=>b.onclick=closeModal)}
    function openYearModal(){$('#modalRoot').innerHTML=`<div class="modal-backdrop"><form id="yearForm" class="modal small"><div class="modal-head"><div><span class="eyebrow">Yearly rollover</span><h2>Create academic year</h2></div><button type="button" data-close>×</button></div><div class="modal-body"><div id="yearError" class="form-error hidden"></div><label class="field"><span>Academic year</span><input id="yearLabel" required placeholder="2027–2028"><small>The new year becomes current. Existing records remain preserved.</small></label></div><div class="modal-actions"><button type="button" class="secondary" data-close>Cancel</button><button class="primary">Create year</button></div></form></div>`;$$('[data-close]',$('#modalRoot')).forEach(b=>b.onclick=closeModal);$('#yearForm').onsubmit=e=>{e.preventDefault();let label=$('#yearLabel').value.trim().replace('-','–');if(!/^20\d{2}–20\d{2}$/.test(label)||state.years.some(y=>y.label===label)){const box=$('#yearError');box.textContent='Enter a unique year such as 2027–2028.';box.classList.remove('hidden');return}state.years.forEach(y=>y.current=false);const id=uid();state.years.unshift({id,label,current:true,archived:false});state.selectedYearId=id;save();renderYearSelect();closeModal();render();toast('New academic year created.')}}
    function yearAction(id,action){const y=state.years.find(x=>x.id===id);if(action==='restore')y.archived=false;if(action==='archive'){y.archived=true;y.current=false;state.students.filter(s=>s.yearId===id).forEach(s=>s.active=false)}if(action==='current'){state.years.forEach(x=>x.current=false);y.current=true;y.archived=false}save();renderYearSelect();render();toast(action==='archive'?'Academic year archived.':action==='restore'?'Academic year restored.':'Current academic year updated.')}
    function closeModal(){$('#modalRoot').innerHTML=''}

    function csvCell(v){const s=String(v??'');return /[",\n]/.test(s)?'"'+s.replaceAll('"','""')+'"':s}
    function download(name,text){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type:'text/csv;charset=utf-8'}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
    function exportStudents(){const y=selectedYear(),rows=yearStudents(true).map(s=>[s.roll,s.name,s.level,s.combo,s.active]);download('students-'+y.label.replace('–','-')+'.csv',[['roll_number','full_name','level','combination','is_active'],...rows].map(r=>r.map(csvCell).join(',')).join('\n'));toast('Student CSV exported.')}
    function exportAttendance(yearId){const y=state.years.find(x=>x.id===yearId),students=state.students.filter(s=>s.yearId===yearId),rows=[];Object.entries(state.attendance).forEach(([date,records])=>students.forEach(s=>{if(records[s.id])rows.push([date,s.roll,s.name,s.level,s.combo,records[s.id]])}));download('attendance-'+y.label.replace('–','-')+'.csv',[['date','roll_number','full_name','level','combination','status'],...rows.sort((a,b)=>b[0].localeCompare(a[0]))].map(r=>r.map(csvCell).join(',')).join('\n'));toast('Attendance CSV exported.')}
    function exportTemplate(){download('student-import-template.csv','roll_number,full_name,level,combination,is_active\n1301,Sample Student,A1,PCF,true');toast('CSV template downloaded.')}
    function parseCsv(text){const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){const c=text[i],n=text[i+1];if(c==='"'&&quoted&&n==='"'){cell+='"';i++}else if(c==='"')quoted=!quoted;else if(c===','&&!quoted){row.push(cell.trim());cell=''}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&n==='\n')i++;row.push(cell.trim());if(row.some(Boolean))rows.push(row);row=[];cell=''}else cell+=c}row.push(cell.trim());if(row.some(Boolean))rows.push(row);return rows}
    function importCsv(file){const reader=new FileReader();reader.onload=()=>{try{const rows=parseCsv(String(reader.result));if(rows.length<2)throw Error('The CSV has no student rows.');const headers=rows[0].map(h=>h.toLowerCase().replaceAll(' ','_'));let count=0;rows.slice(1).forEach((r,index)=>{const obj=Object.fromEntries(headers.map((h,i)=>[h,r[i]||''])),roll=obj.roll_number||obj.roll, name=obj.full_name||obj.name,level=obj.level||obj.class,combo=obj.combination||obj.subject_combination;if(!/^\d{4}$/.test(roll)||!name||!CLASSES.includes(level)||!combosFor(level).includes(combo))throw Error('Invalid data on CSV row '+(index+2)+'.');if(state.students.some(s=>s.yearId===state.selectedYearId&&s.roll===roll))throw Error('Duplicate roll number '+roll+' on row '+(index+2)+'.');state.students.push({id:uid(),roll,name,level,combo,yearId:state.selectedYearId,active:!['false','0','inactive','no'].includes(String(obj.is_active||'true').toLowerCase())});count++});save();render();toast(count+' students imported.')}catch(err){toast(err.message||'Could not import CSV.','error')}};reader.readAsText(file)}

    function changeDate(date){if(!date)return;state.selectedDate=date;$('#globalDate').value=date;save();render()}
    $('#loginForm').onsubmit=e=>{e.preventDefault();if($('#loginCode').value!=='BNKS2026'){$('#loginError').classList.remove('hidden');return}faculty=$('#loginName').value.trim();sessionStorage.setItem(SESSION_KEY,faculty);showApp()};
    $('#logoutButton').onclick=()=>{sessionStorage.removeItem(SESSION_KEY);faculty='';showApp()};
    $('#globalDate').onchange=e=>changeDate(e.target.value);$('#yearSelect').onchange=e=>{state.selectedYearId=e.target.value;save();filters={search:'',level:'All classes',combo:'All combinations',activity:'All students'};render()};
    $$('.nav button').forEach(b=>b.onclick=()=>{page=b.dataset.page;$('#sidebar').classList.remove('open');$('#scrim').classList.add('hidden');render()});
    $('#menuButton').onclick=()=>{$('#sidebar').classList.add('open');$('#scrim').classList.remove('hidden')};$('#closeNav').onclick=$('#scrim').onclick=()=>{$('#sidebar').classList.remove('open');$('#scrim').classList.add('hidden')};
    $('#csvInput').onchange=e=>{const file=e.target.files[0];if(file)importCsv(file);e.target.value=''};
    window.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
    showApp();
  })();
  </script>
</body>
</html>
