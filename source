    .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.metric{min-height:122px;display:flex;align-items:flex-start;gap:13px;padding:20px}.metric-icon{width:40px;height:40px;display:grid;place-items:center;flex:0 0 auto;border-radius:11px;font-size:18px}.metric-icon.green{background:#e3f1ea;color:#246b4e}.metric-icon.blue{background:#e7f0f7;color:#416f93}.metric-icon.red{background:#fae9e7;color:#b14e47}.metric-icon.amber{background:#f8efdc;color:#9b7027}.metric span,.metric b,.metric small{display:block}.metric span{color:#6e7a74;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.5px}.metric b{margin-top:8px;font:700 28px Georgia,serif;color:#1d382d}.metric small{margin-top:7px;color:#8c9892;font-size:9px}.dashboard-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:15px;margin-top:15px}.panel-head{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:17px 20px;border-bottom:1px solid #edf1ef}.panel-head h2{margin:0;font:700 16px Georgia,serif;color:#1d382d}.panel-head p{margin:5px 0 0;color:#87938d;font-size:9px}.overview-body{min-height:218px;display:grid;grid-template-columns:1fr 1.25fr;align-items:center;gap:25px;padding:22px}.donut{--rate:0deg;width:145px;aspect-ratio:1;display:grid;place-items:center;margin:auto;border-radius:50%;background:conic-gradient(var(--green) 0 var(--rate),#e7edea var(--rate))}.donut:before{content:"";grid-area:1/1;width:104px;aspect-ratio:1;border-radius:50%;background:#fff}.donut>div{grid-area:1/1;z-index:1;text-align:center}.donut b,.donut span{display:block}.donut b{font:700 25px Georgia,serif}.donut span{margin-top:4px;color:#87938d;font-size:8px;text-transform:uppercase;letter-spacing:.7px}.legend{display:grid;gap:13px}.legend-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;color:#66736d;font-size:10px}.dot{width:8px;height:8px;border-radius:50%;background:var(--status)}.legend-row b{color:#2c4137}.class-list{display